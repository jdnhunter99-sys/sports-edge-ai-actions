    {
      "Col1": "Joshua Moore",
      "Col2": "",
      "Col3": "",
      "Col4": "OFS",
      "Col5": "WR",
      "Col6": "FALSE",
      "Col7": "13.4",
      "Col8": "2",
      "Col9": "9/22/2026",
      "Col10": "Suffered an upper-body injury in the 33-20 win at Wake Forest on Sept. 18, a game he finished after scoring the first touchdown. Mario Cristobal ruled him out for the season three days later, ending his year at seven catches for 107 yards and two scores.",
      "Col11": "0"
    },
    {
      "Col1": "CharMar Brown",
      "Col2": "",
      "Col3": "",
      "Col4": "OFS",
      "Col5": "RB",
      "Col6": "FALSE",
      "Col7": "15.3",
      "Col8": "2",
      "Col9": "9/22/2026",
      "Col10": "Injured his right knee at the end of a 32-yard run in the second quarter of the Sept. 18 win at Wake Forest and left on a cart. Mario Cristobal ruled him out for the season three days later.",
      "Col11": "0"
    },
    {
      "Col1": "Luka Gilbert",
      "Col2": "",
      "Col3": "",
      "Col4": "OFS",
      "Col5": "TE",
      "Col6": "FALSE",
      "Col7": "12.4",
      "Col8": "0",
      "Col9": "8/4/2026",
      "Col10": "Mario Cristobal announced at the start of fall camp that the sophomore tight end would miss the entire 2026 season with an undisclosed injury. He had been a candidate for the No. 2 job behind Elija Lofton.",
      "Col11": "0"
    },
    {
      "Col1": "Ja'Boree Antoine",
      "Col2": "",
      "Col3": "",
      "Col4": "O",
      "Col5": "DB",
      "Col6": "FALSE",
      "Col7": "10.8",
      "Col8": "0",
      "Col9": "10/5/2026",
      "Col10": "Has not played this season after suffering an undisclosed injury before the opener. Mario Cristobal said in September that he expects the sophomore cornerback back in the latter part of the season, and he remains out for the Nov. 14 game against Duke.",
      "Col11": "0"
    },
    {
      "Col1": "Romanas \"OJ\" Frederique Jr.",
      "Col2": "",
      "Col3": "",
      "Col4": "O",
      "Col5": "DB",
      "Col6": "FALSE",
      "Col7": "13.4",
      "Col8": "2",
      "Col9": "10/5/2026",
      "Col10": "Injured his left shoulder making an open-field tackle on the second play of the 45-6 opening win at Stanford and has not played since. Mario Cristobal said he is progressing well but is still looking at a return late in the season or in the postseason, and he is out for the Nov. 14 game against Duke.",
      "Col11": "0"
    },
    {
      "Col1": "Max Buchanan",
      "Col2": "",
      "Col3": "",
      "Col4": "O",
      "Col5": "OL",
      "Col6": "FALSE",
      "Col7": "13.0",
      "Col8": "2",
      "Col9": "10/7/2026",
      "Col10": "Injured his left knee in the second quarter of the 41-13 win over Clemson on Oct. 3 and had surgery days later. Mario Cristobal said the right guard has a chance to return for the regular-season finale against Boston College on Nov. 28 or in the postseason.",
      "Col11": "0"
    },
    {
      "Col1": "Malachi Toney",
      "Col2": "",
      "Col3": "",
      "Col4": "O",
      "Col5": "WR",
      "Col6": "FALSE",
      "Col7": "17.8",
      "Col8": "5",
      "Col9": "11/4/2026",
      "Col10": "Suffered a high ankle sprain in practice on Nov. 4, had TightRope surgery the next morning and missed the 31-24 loss at Notre Dame. Mario Cristobal said he is on schedule in rehab and could return as soon as four to four and a half weeks after the procedure, which points to the ACC Championship Game on Dec. 5 at the earliest.",
      "Col11": "0"
    },
